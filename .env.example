# ─── Banco de dados ───────────────────────────────────────────────
POSTGRES_USER=pulsefx
POSTGRES_PASSWORD=troque-em-producao
POSTGRES_DB=pulsefx
DATABASE_URL=postgresql://pulsefx:troque-em-producao@localhost:5432/pulsefx

# ─── API ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3333
CORS_ORIGINS=http://localhost:5173

# Token do endpoint administrativo de sincronização manual.
# Gere um valor aleatório com 64 caracteres hexadecimais:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SYNC_TOKEN=

# ─── Fontes de dados ──────────────────────────────────────────────
# FRED exige chave. Registre em https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
FRED_BASE_URL=https://api.stlouisfed.org/fred

# BCB é público, sem chave.
BCB_OLINDA_BASE_URL=https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata
BCB_SGS_BASE_URL=https://api.bcb.gov.br/dados/serie/bcdata.sgs

# ─── Sincronização ────────────────────────────────────────────────
SYNC_ON_STARTUP=true
SYNC_INTERVAL_MINUTES=120
# O SGS do BCB é lento: medido em 14,4s numa consulta de 20 observações em
# 29/08/2026. Timeout de 8s reprovaria chamadas legítimas.
BCB_TIMEOUT_MS=25000
FRED_TIMEOUT_MS=8000

# ─── Rate limit ───────────────────────────────────────────────────
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MINUTES=1
